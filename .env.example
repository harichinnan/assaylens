# =============================================================================
# AssayLens — environment configuration
# Copy to `.env` and adjust. `.env` is gitignored.
# =============================================================================

# ---- Postgres (analytical warehouse / serving DB) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assaylens
POSTGRES_USER=assaylens
POSTGRES_PASSWORD=assaylens
# Read-only role used by the agent's run_curated_sql tool. Created by
# postgres/init/01_schemas.sql. Keep this account least-privilege.
POSTGRES_RO_USER=agent_ro
POSTGRES_RO_PASSWORD=agent_ro

# ---- Elasticsearch (search layer) ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=assaylens_activity_evidence
# Single-node dev cluster ships with security disabled (see docker-compose.yml).
# If you enable security, set these:
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ---- Metabase (BI layer) ----
METABASE_URL=http://localhost:3000
# Browser-facing URL used to build embed iframes (must be reachable from the user).
MB_SITE_URL=http://localhost:3000
# Provisioned by metabase/setup_metabase.py — it prints these after a run.
MB_EMBEDDING_SECRET_KEY=
MB_DASH_OVERVIEW=
MB_DASH_TARGET=
MB_DASH_COMPOUND=
MB_DASH_QUALITY=
MB_ADMIN_EMAIL=admin@assaylens.local
MB_ADMIN_PASSWORD=AssayLens#2026demo

# ---- Agent (FastAPI) ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# Governance knobs for run_curated_sql
SQL_MAX_ROWS=200
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_DEFAULT_LIMIT=100

# ---- LLM (Anthropic Claude Haiku) ----
# The LLM only classifies intent, selects tools, and summarizes compact
# tool results. It never receives raw data dumps.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Streamlit UI ----
AGENT_API_URL=http://localhost:8000

# ---- ChEMBL ingestion ----
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
# Set to "true" to ingest from committed sample fixtures (offline / CI).
CHEMBL_OFFLINE=false
